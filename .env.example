# Optional — enables the (not-yet-live) AI interview scoring feature.
# See server/anthropic.js. Without this set, scoring is disabled and throws
# a clear error rather than silently doing nothing.
ANTHROPIC_API_KEY=

# Optional — enables machine translation of dynamic content (job/company
# descriptions) into Hungarian/French. See server/translate.js. Without
# this set, translation is a no-op and original English text is shown.
GOOGLE_TRANSLATE_API_KEY=
